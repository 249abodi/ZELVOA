# Database
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:8080/zelvoa?schema=public"

# Auth
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS"
SESSION_TTL_DAYS=30

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Encryption key for OAuth token encryption at rest (32 bytes hex)
ENCRYPTION_KEY="CHANGE_ME_32_BYTE_HEX"

# Social publishing scheduler
# Secret that authenticates the cron endpoint /api/v1/scheduler/run.
# Generate a long random value locally and set it in Vercel Project Settings.
# Vercel sends it automatically as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Development providers
# Set to "true" ONLY in local/dev environments to enable a built-in mock provider
# that creates clearly-labelled development accounts. Never enable in production.
ALLOW_DEV_PROVIDERS="false"

# Social platform OAuth2 credentials (names only — values in your environment,
# never committed). A platform is shown as available once its pair is set.
# Facebook Pages and Instagram Business both connect through one Meta app:
# set FACEBOOK_CLIENT_ID/FACEBOOK_CLIENT_SECRET and Instagram is enabled too.
# The INSTAGRAM_* vars are an optional fallback for a dedicated IG app.
# FACEBOOK_CLIENT_ID=""
# FACEBOOK_CLIENT_SECRET=""
# INSTAGRAM_CLIENT_ID=""
# INSTAGRAM_CLIENT_SECRET=""
# LINKEDIN_CLIENT_ID=""
# LINKEDIN_CLIENT_SECRET=""
# X_CLIENT_ID=""
# X_CLIENT_SECRET=""
# TIKTOK_CLIENT_ID=""
# TIKTOK_CLIENT_SECRET=""
# YOUTUBE_CLIENT_ID=""
# YOUTUBE_CLIENT_SECRET=""

# AI — OpenAI-compatible provider (server-only, never exposed to the browser)
# Required for the AI assistant to function. Without AI_API_KEY the studio stays
# disabled and returns AI_NOT_CONFIGURED. Never commit real keys.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Object storage (S3-compatible). When STORAGE_BUCKET is set, uploaded media
# is stored in the bucket. Production on Vercel MUST set a bucket because the
# serverless function filesystem is read-only and ephemeral. Without a bucket,
# a local ./storage directory is used for development only.
STORAGE_BUCKET=""
STORAGE_REGION="us-east-1"
# Optional S3-compatible endpoint (e.g. Cloudflare R2) and path-style access.
# STORAGE_ENDPOINT=""
# STORAGE_FORCE_PATH_STYLE="true"
# Credentials are picked up automatically by the AWS SDK from
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.